# Gemini Traceable Tool Agent — environment variables
# Copy to .env for local dev. NEVER commit real keys. On Hugging Face Spaces,
# set these as Space "secrets" (Settings -> Variables and secrets), not in code.

# --- Gemini (runtime; required) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Arize Phoenix Cloud (tracing/eval backend; required for traces) ---
# Endpoint is the SPACE base URL; the OTLP HTTP exporter posts to <endpoint>/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/rapidagent
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=gemini-traceable-tool-agent

# --- Public-demo abuse controls (Hugging Face Space) ---
DEMO_MAX_INPUT_CHARS=1200
DEMO_DAILY_CALL_LIMIT=120
AGENT_MAX_ITERS=5
TOOL_TIMEOUT_SECONDS=12

# --- Optional judge-only access gate for the hosted demo ---
# If both are set, the app requires login (protects the capped key from random public use).
# Share these privately with judges via the Devpost submission, not the public repo.
DEMO_AUTH_USER=
DEMO_AUTH_PASSWORD=

# --- Auxiliary AI router (optional; src/ai_helper.py) ---
# The CORE agent runtime is always Gemini. These only affect secondary AI (LLM-judge,
# Chinese copy review). Order: openclaw CLIs -> China proxies -> Gemini fallback.
# OPENCLAW_HOST=alanwen@openclaw
# QWEN_PROXY_TOKEN=        # else read from ~/aipm/credentials/qianwen_dashscope.env
# ARK_PROXY_TOKEN=         # else read from ~/aipm/credentials/doubao_volcengine.env
# DEEPSEEK_PROXY_TOKEN=    # else read from ~/aipm/credentials/deepseek.env
